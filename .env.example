# Public base URL; used for QR codes, tracking links and WhatsApp message links.
# Production: https://washtrack.craftlayer.store  ·  Local dev: http://localhost:3147
APP_URL=http://localhost:3147

# 32+ random characters. Signs the staff session cookie. Required in production.
SESSION_SECRET=

# Optional Postgres connection string. When empty, a local PGlite database in ./.data/pglite is used.
DATABASE_URL=

# Optional: where the PGlite dev database lives.
# PGLITE_DIR=./.data/pglite
